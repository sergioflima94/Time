# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings -> API, em supabase.com). Veja o README para o passo a passo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AdMob (anúncios reais — ver src/components/AdBanner.tsx e README).
# test (padrão) para validação; production exige IDs reais; off desliga anúncios.
# EAS preview força test, EAS production exige configuração real no ambiente production.
# IDs públicos: nunca coloque senha ou credencial de serviço aqui.
EXPO_PUBLIC_ADMOB_MODE=test
#
# App ID: crie o app no console do AdMob (apps.admob.com) -> "IDs de apps".
# Exige build nativo (EAS Build/dev client); não funciona no Expo Go.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Ad Unit ID do banner (AdMob -> seu app -> "Unidades de anúncio" -> Banner).
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=

# Assinatura digital nas lojas via RevenueCat. Somente chaves públicas do SDK.
# Não coloque chave secreta, recibos ou credenciais das lojas neste arquivo.
# Configure produtos/entitlement no painel antes de gerar um novo build nativo.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING=premium
