{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "test" },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "production" },
      "autoIncrement": false
    },
    "store": {
      "extends": "production",
      "environment": "production",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "off" },
      "android": { "buildType": "app-bundle" }
    },
    "store-screenshots": {
      "extends": "store",
      "environment": "preview",
      "withoutCredentials": true,
      "ios": { "simulator": true, "config": "store-screenshots.yml" }
    },
    "store-capture-only": {
      "extends": "store-screenshots",
      "ios": { "config": "store-capture-only.yml" }
    },
    "store-capture-ipad": {
      "extends": "store-capture-only",
      "env": { "STORE_CAPTURE_FAMILY": "ipad" }
    }
  },
  "submit": {
    "production": {},
    "store": {
      "ios": {
        "ascAppId": "6822250993",
        "appleId": "sergioferreiralima09@gmail.com"
      }
    }
  }
}
