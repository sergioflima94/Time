{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "test" },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "production" },
      "autoIncrement": false
    },
    "store": {
      "extends": "production",
      "environment": "production",
      "env": { "EXPO_PUBLIC_ADMOB_MODE": "off" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {},
    "store": {
      "ios": {
        "ascAppId": "6822250993",
        "appleId": "sergioferreiralima09@gmail.com"
      }
    }
  }
}
