DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # This package is for the domain root, not app.marcoujogou.com.br.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?marcoujogou\.com\.br$ [NC]
  RewriteRule ^ https://marcoujogou.com.br%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.marcoujogou\.com\.br$ [NC]
  RewriteRule ^ https://marcoujogou.com.br%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
</IfModule>
